-- ── SECCIÓN DDL ──────────────────────────
-- DROP TABLE
-- CREATE TABLE

DROP TABLE IF EXISTS inventario;

create table inventario(
 id_producto int not null identity (1,1) primary key, --elegi que el id sea int para poder incrementarlo solo y de uno en uno , obviamente es la PK porque es unico
 nombre_producto varchar(100),
 categoria varchar(50),
 precio_unitario decimal(10,2),  --los precios hay que manejarlos con punto flotante ya que nunca son numeros redondos
 stock_actual int, 
 stock_minimo int,
 fecha_ingreso date,  --las fechas deben manejarse con el tipo de dato DATE
 activo bit --Valor 1 para que este activo y 0 para que no este , es mas eficiente este tipo de dato , como estoy en sql server utilizo bit para TINYINT
);

